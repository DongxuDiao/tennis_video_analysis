frontend/node_modules/
frontend/dist/
# tsc 副产物（vite.config.ts 的编译输出与增量缓存）
frontend/vite.config.js
frontend/vite.config.d.ts
frontend/*.tsbuildinfo
backend/.venv/
backend/node_modules/
backend/.playwright-cli/
frontend/.playwright-cli/
