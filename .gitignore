backend/app/skill_runtime/vendor/
**/__pycache__/
.pytest_cache/
data/app.sqlite*
data/projects/
data/exports/
data/models/*.pt
data/models/*.task
# 本地大模型权重（数 GB，走 data/manifest 或独立下载）
data/local_models/
# 实验工作区与产物视频，不属于源码
work/
outputs/
reports/artifacts/

# Docker credentials and deployment backups (never commit).
.docker-state/
